<!DOCTYPE html>

<head>
    <title> Kiểm tra số lớn hơn hay nhỏ hơn 0</title>
</head>
<body>

    <h2>Kiểm tra số lớn hơn hoặc nhỏ hơn 0</h2>

    <p>Nhập một số nguyên:</p>
    <input type="number" id="so"><br><br>

    <button onclick="kiemTraSo()">Kiểm tra</button>

    <p id="ketqua"></p>

    <script>
        function kiemTraSo() {
          let val = document.getElementById("so").value;
          let ketqua= document.getElementById("ketqua");      
            let n = Number(val);

            if (n > 0) {
                ketqua = n + " là số lớn hơn 0";
            } else if (n < 0) {
                ketqua = n + " là số nhỏ hơn 0";
            } else {
                ketqua = "Số bạn nhập là số 0";
            }
            document.getElementById("ketqua").innerHTML = ketqua
        }
    </script>

</body>
</html>
